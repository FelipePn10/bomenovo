# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# Todas as variáveis são opcionais: sem o .env a API usa os padrões de app/core/config.py.

# Chave usada para assinar os tokens JWT. Use um texto grande e aleatório, por exemplo:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-bem-grande-e-aleatoria

# Algoritmo de assinatura do JWT
ALGORITHM=HS256

# Tempo de validade do token, em minutos (depois disso o app pede login de novo)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Banco de dados. Local: SQLite (arquivo tarefas.db criado na pasta backend/)
DATABASE_URL=sqlite:///./tarefas.db
# Hospedado (Render, Neon...): use a URL do PostgreSQL, por exemplo:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco
